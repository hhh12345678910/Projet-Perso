[Unit]
Description=Betano odds ingest endpoint (receives pushes from the browser userscript)
Documentation=https://github.com/hhh12345678910/Projet-Perso
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust User/Group/paths to match your deploy if it isn't the `ubuntu` user.
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/Projet-Perso
# Loads BETANO_INGEST_TOKEN (and optional BETANO_INGEST_FILE/PORT/HOST) from
# .env. The leading `-` makes it non-fatal if .env is missing, but the server
# refuses to start without a token, so make sure BETANO_INGEST_TOKEN is set.
EnvironmentFile=-/home/ubuntu/Projet-Perso/.env
ExecStart=/home/ubuntu/Projet-Perso/.venv/bin/python /home/ubuntu/Projet-Perso/scripts/betano_ingest_server.py
Restart=always
RestartSec=10

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
