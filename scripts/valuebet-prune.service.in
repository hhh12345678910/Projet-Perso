### Gabarit — __USER__ et __PROJECT_DIR__ sont remplacés par scripts/setup.sh.
### Ne pas copier ce fichier tel quel dans /etc/systemd/system.
[Unit]
Description=Prune old valuebet quote rows and stale dedup marks

[Service]
Type=oneshot
User=__USER__
WorkingDirectory=__PROJECT_DIR__
# Pas de --days ici : la rétention se règle par PRUNE_DAYS dans .env, que
# runscan.sh charge avant de lancer Python. Un drapeau en dur ici l'emporterait
# sur .env, et il faudrait éditer une unité systemd pour changer un chiffre.
ExecStart=__PROJECT_DIR__/runscan.sh prune
