# Copy to .env and fill in. Never commit .env.
# Betano cookie: capture from your browser (DevTools → Network → any
# /danae-webapi/ request → Copy as cURL → extract the value after `-b '`).
# Expires every few hours (Cloudflare cf_clearance + DataDome tokens).
BETANO_COOKIE=
BETANO_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36
# Optional override (default already targets Betano BE / French)
BETANO_X_LANGUAGE=9
BETANO_X_OPERATOR=22

# ---------------------------------------------------------------------------
# Import d'historique des paris (suivi P&L réel — commande `import-history`).
# Chaque book Kambi expose l'historique du compte connecté à :
#   https://cf-mt-auth-api.kambicdn.com/player/api/v2019/<offering>/coupon/history.json
# (offering ubbe=Unibet, sevelevbe=711, bingoalbe=Bingoal, bnlbe=Scooore).
# La session Kambi est courte (~1h) : à recapturer quand `import-history`
# renvoie une erreur d'authentification.
#
# Comment capturer (connecté sur le site, page « Historique des paris ») :
#   DevTools (F12) → Network → clic sur la requête coupon/history.json →
#   « Copy as cURL ». Dedans tu récupères :
#     • l'URL          → <PREFIX>_HISTORY_URL
#     • le -H 'cookie: …'        s'il existe → <PREFIX>_COOKIE
#     • le -H 'authorization: …' s'il existe → <PREFIX>_AUTH
#   Au moins l'un des deux (COOKIE ou AUTH) est requis.
# Entoure chaque valeur de guillemets SIMPLES (caractères spéciaux) car .env
# est sourcé par bash.
UNIBET_HISTORY_URL=
UNIBET_COOKIE=
UNIBET_AUTH=
SEVEN_ELEVEN_HISTORY_URL=
SEVEN_ELEVEN_COOKIE=
SEVEN_ELEVEN_AUTH=
BINGOAL_HISTORY_URL=
BINGOAL_COOKIE=
BINGOAL_AUTH=
SCOOORE_HISTORY_URL=
SCOOORE_COOKIE=
SCOOORE_AUTH=
# À n'ajuster QUE si les montants/cotes sortent faux face à une vraie capture
# (défauts : entiers ×1000). Vérifie avec `import-history --dump-raw` puis
# `inspect-kambi-history`.
# KAMBI_MONEY_SCALE=1000
# KAMBI_ODDS_SCALE=1000
