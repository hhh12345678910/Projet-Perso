# Copy to .env and fill in. Never commit .env.
# Betano cookie: capture from your browser (DevTools → Network → any
# /danae-webapi/ request → Copy as cURL → extract the value after `-b '`).
# Expires every few hours (Cloudflare cf_clearance + DataDome tokens).
BETANO_COOKIE=
BETANO_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36
# Optional override (default already targets Betano BE / French)
BETANO_X_LANGUAGE=9
BETANO_X_OPERATOR=22

# --- Betano ingest server (browser userscript -> VM) -----------------------
# Preferred way to feed Betano: the tools/betano-ingest.user.js userscript runs
# in your browser (valid cookies, home IP), fetches the live overview and POSTs
# it to scripts/betano_ingest_server.py, which writes the JSON below. The daemon
# reads it via --betano-file (auto-wired in scan-daemon.sh). No more cookie
# pasting. Generate the token with:  openssl rand -hex 32  — and paste the SAME
# value into the userscript's TOKEN constant. Keep these lines free of inline
# `#` comments: systemd's EnvironmentFile treats the rest of the line as value.
BETANO_INGEST_TOKEN=
# Staleness guard: both feeds only advance while a browser tab is open on
# betanosports.be, so a closed tab or a sleeping PC leaves the files frozen
# rather than missing. Past these ages the daemon ignores them and says so,
# instead of pricing hours-old odds as live. 0 disables the check.
BETANO_LIVE_MAX_AGE_MIN=5
BETANO_PREMATCH_MAX_AGE_MIN=30
# Optional overrides (defaults shown):
# BETANO_PREMATCH_DIR=<project>/data/prematch
# BETANO_COOKIE_FILE=<project>/data/betano_cookie.json
# BETANO_INGEST_FILE=<project>/data/betano.json
# BETANO_INGEST_PORT=8787
# BETANO_INGEST_HOST=0.0.0.0
# BETANO_FILE is what scan-daemon.sh passes to --betano-file; defaults to the
# ingest file above. Set BETANO_FILE= (empty) to fall back to the live cookie.

# ---------------------------------------------------------------------------
# Staking (mode de mise). Défaut "kelly" = comportement historique (quart de
# Kelly, embarque le 1/(cote-1) qui sur-mise les cotes basses).
# "flat" = mise STABLE : base = STAKE_PCT % de la bankroll (TELEGRAM_BANKROLL),
#   boost DOUX de l'EV, et AUCUNE influence de la cote. Recommandé.
STAKE_MODE=flat
STAKE_PCT=2.0              # mise de base = ce % de la bankroll (2% de 1250 = 25€)
STAKE_BASE_EUR=25          # base € fixe, utilisé seulement si STAKE_PCT=0
STAKE_EV_TIER=15           # EV% à partir duquel léger boost
STAKE_EV_MULT=1.25         # boost DOUX de l'EV (1.0 = l'EV n'influence pas du tout ; 25€ -> 30€)

# Canal critique : le SEUL canal sans filtre de cote — il ne teste que l'EV.
# C'est donc là qu'atterrissent les EV extrêmes sur grosses cotes, que toutes
# les autres voies écartent par leurs bandes 1.5-4.0 / 4.0-6.0. Prématch
# uniquement. Non défini = ces paris ne sont routés nulle part.
TELEGRAM_CRITICAL_CHAT_ID=
TELEGRAM_MIN_CRITICAL_EV=35.0
# Seconde voie du critique : les grosses cotes que le premium REFUSE.
# Sans elle, un pari en cote 4-6 écarté du premium (exclusion tennis, ou
# canal premium absent) devait atteindre 35 % d'EV pour reparaître ; entre
# 20 et 35 % il ne partait nulle part. Fermer une bande au premium doit
# déplacer ces paris, pas les effacer. Jamais de doublon : le critique ne
# prend que ce que le premium n'a pas pris.
TELEGRAM_CRITICAL_HI_EV=20.0
TELEGRAM_CRITICAL_HI_MIN_ODD=4.0

# Canal maintenance : les alertes d'EXPLOITATION (book muet, Pinnacle muet et
# leurs rétablissements). Elles ne se jouent pas, elles se réparent — les
# méler aux value bets exceptionnels oblige à trier à l'oeil au pire moment.
# Non défini = comportement inchangé : elles partent sur le canal critique,
# et à défaut sur le chat principal. Une panne ne doit jamais disparaître.
TELEGRAM_MAINTENANCE_CHAT_ID=

# Voie premium "grosses cotes" : les cotes premium_hi_min..max ne partent en
# premium QUE si l'EV dépasse ce seuil (en plus de la voie standard 1.5-4/EV>=8).
TELEGRAM_PREMIUM_HI_EV=20
TELEGRAM_PREMIUM_HI_MIN_ODD=4.0
TELEGRAM_PREMIUM_HI_MAX_ODD=6.0

# Rétention des cotes brutes, en jours. C'est le seul levier sur la taille de
# la base : mesuré le 01/08, deux jours pèsent 23 Go de données utiles. Une
# journée suffit dès lors que valuebet-close-lines.timer tourne toutes les
# heures — la ligne de clôture est capturée dans l'heure suivant le coup
# d'envoi, bien avant que la purge n'atteigne ces lignes.
PRUNE_DAYS=2

# --- Marchés en retard -------------------------------------------------------
# Un book qui n'a pas suspendu son marché prématch sur un match déjà commencé.
# Alerte sur le canal critique. Ce n'est PAS un value bet : c'est une erreur
# d'exploitation du book, et elle ne doit pas polluer la mesure de CLV.
LATE_MARKET_ENABLED=1          # 0 = coupe TOUT le détecteur (les deux variantes
                               # « BUT — MARCHÉ TOUJOURS OUVERT » et « MARCHÉ EN
                               # RETARD »), détection comprise. Aucun autre type
                               # d'alerte n'est concerné.
LATE_MARKET_MIN_MINUTES=10     # en dessous : coups d'envoi retardés, faux positifs
LATE_MARKET_MAX_MINUTES=75     # au-delà : horaire faux plutôt qu'oubli
LATE_MARKET_COOLDOWN_SEC=300   # rappel toutes les 5 min tant que le marché reste ouvert

# --- Smarkets : seconde référence sharp (repli strict derrière Pinnacle) -----
# Exchange londonien, API publique sans authentification. Utilisé comme SOURCE
# DE DONNÉES uniquement — on ne parie pas dessus, et il n'apparaît jamais dans
# le lot des books soft. Ses prix sont sans marge par construction.
# Servi par un cache de fond : le cycle de scan ne l'attend jamais.
SMARKETS_ENABLED=1
SMARKETS_REFRESH_SEC=300      # âge à partir duquel un rafraîchissement part en fond
SMARKETS_MAX_AGE_SEC=1800     # au-delà, le cache rend RIEN plutôt que des cotes mortes
SMARKETS_HOURS=48             # horizon : au-delà, la ligne bouge encore trop
SMARKETS_REQUEST_DELAY=0.5    # espacement entre requêtes (limite de débit par IP)

# --- Écriture parcimonieuse de `quotes` -------------------------------------
# Un marché n'est écrit que s'il a BOUGÉ (99,6 % des cotes Pinnacle sont
# identiques d'un cycle à l'autre). Le marché est réécrit ENTIER dès qu'une
# issue change, pour que les clôtures gardent un instant de capture unique —
# l'invariant dont dépend le devig, donc toute la mesure de CLV.
# Le battement de cœur réécrit un marché stable à intervalle fixe : sans lui,
# un book aux cotes figées deviendrait indiscernable d'un book en panne.
QUOTES_HEARTBEAT_SEC=1800

# --- MagicBetting (plateforme Digitain), via pont navigateur ----------------
# L'API est derrière Cloudflare, qui refuse les IP de datacenter : mesuré, la
# VM reçoit 403 là où le navigateur reçoit 200. Le userscript
# tools/magicbetting-ingest.user.js relaie les réponses CHIFFRÉES ; le serveur
# d'ingestion les déchiffre avec le module WebAssembly du site lui-même.
#
# Le .wasm se récupère dans l'onglet Network du navigateur (filtre Wasm) et se
# dépose à cet emplacement. Il est servi sous un chemin versionné : à
# re-télécharger si le déchiffrement se met à échouer partout.
DIGITAIN_WASM=data/digitain_decrypt.wasm

# --- Balayage MagicBetting (Digitain) --------------------------------------
# gettopeventslist ne rend que la vitrine : 27 matchs, quand le catalogue du
# site en annonce 1173 en football. L'offre entière se demande compétition par
# compétition, ce qui coûte un appel chacune — d'où ces deux plafonds.
# MAGIC_BUDGET_EVENTS vise un nombre d'événements ; MAGIC_MAX_CALLS borne le
# nombre d'appels par tour et par sport, et c'est lui le vrai garde-fou : la
# longue traîne des compétitions à un match épuiserait le premier sans jamais
# entamer le second.
MAGIC_BUDGET_EVENTS=500
MAGIC_MAX_CALLS=30
MAGIC_MAX_COUNTRIES=25
# Le catalogue (pays puis compétitions) se reconstruit à cet intervalle. Les
# calendriers ne changent pas à la minute.
MAGIC_CATALOG_TTL_SEC=1800
# Âge maximal d'un morceau dans l'assemblage. Plus large que la garde du
# daemon sur le fichier final, parce que la longue traîne ne revient que tous
# les quelques tours.
MAGIC_PART_MAX_AGE_MIN=20
MAGIC_REBUILD_SEC=10

# Smarkets sert-il de RÉFÉRENCE de repli sur les marchés que Pinnacle ignore,
# ou seulement d'observateur dans odds_history ?
#
# Par défaut NON, décidé sur mesure le 16/08 : sur 24 paris valorisés contre ce
# repli et jugés au consensus dévigé des softbooks — règle indépendante de
# Smarkets — la CLV ressort à -20,6 % de moyenne et 0 % de positifs. Le repli
# ne se déclenche que sur les marchés que Pinnacle n'a pas, c'est-à-dire
# précisément là où le carnet de l'exchange est vide, et il y prend des offres
# orphelines pour des prix de marché.
#
# La collecte, elle, continue : courbes, comparaisons et CLV restent mesurables,
# donc la décision se réexamine avec des données si la liquidité s'améliore.
SMARKETS_AS_REFERENCE=0

# Smarkets : ÉTEINT depuis le 16/08. Aucun appel, aucun cache, aucune cote.
#
# Mesuré sur la seule règle indépendante disponible — le consensus dévigé des
# softbooks, Pinnacle ne priçant jamais ces marchés : 24 paris, CLV moyenne
# -20,6 %, mediane -21,7 %, 0 % de positifs. Contre sa propre clôture le même
# échantillon affichait +32,8 %, ce qui mesure exactement ce que vaut une
# référence jugée par elle-même.
#
# Structurel, pas accidentel : le repli ne se déclenche que sur les marchés que
# Pinnacle ignore, donc là où le carnet d'un exchange est vide. Mettre 1 pour
# refaire la mesure si sa liquidité change.
SMARKETS_ENABLED=0

# ─────────────────────────── Résultats de matchs (P&L réel) ───────────────────
#
# La table `results` est restée vide de juillet à août : tout le projet mesurait
# la CLV, qui est un indicateur avancé, et jamais un euro réellement gagné.
# `results-update` remplit cette table ; `settle()` et `pnl()` existaient déjà.
#
# Deux fournisseurs, parce qu'aucun ne fait les deux sports : API-Sports couvre
# 1 200+ ligues de football mais PAS le tennis (vérifié le 16/08).
#
# Lancer `results-update --dry-run` AVANT d'y croire : il mesure la couverture
# sur notre univers, pas sur la plaquette du fournisseur.

# Football — https://dashboard.api-football.com (palier gratuit, 100 req/jour).
# Une journée entière tient en UNE requête : 1 215 matchs le 15/08, sans
# pagination.
SCORES_FOOTBALL_KEY=

# ⚠️ API-Sports REFUSE les IP de datacenter et le déguise en suspension de
# compte. Mesuré le 16/08 avec une seule et même clé : 200 depuis une IP
# résidentielle, « Your account is suspended » depuis la VM. Le compte est
# actif ; c'est l'origine qui est rejetée. Ne pas partir déboguer le compte.
#
# 🔴 LA PARADE RAPIDAPI N'EXISTE PLUS — NE PERDS PAS DE TEMPS ICI.
#
# L'idée était bonne : RapidAPI relaie depuis SA propre infrastructure, donc
# API-Sports ne voit jamais l'IP de la VM, et l'abonnement est un compte
# SÉPARÉ — ni le refus d'IP ni la suspension du compte ne s'y appliquent.
#
# Mais le listing a disparu. Constaté TROIS fois, de trois façons différentes :
#   - 18/08 (§20.5) : la page d'éditeur rendait « Something Went Wrong » ;
#   - 21/08 (§21.9) : introuvable sur le site, noté « à re-chercher » ;
#   - 21/08 (§21.16) : `rapidapi.com/api-sports/api/api-football` répond
#     « NOT_FOUND — API not found », capture d'écran à l'appui.
#
# Le code ci-dessous RESTE en place et fonctionne : si API-Sports reparaît un
# jour sur RapidAPI ou sur une autre place de marché compatible, poser la clé
# suffit toujours à basculer la route. Mais ce n'est plus une voie à essayer,
# c'est une porte à rouvrir si elle se rouvre. Laisser vide.
SCORES_FOOTBALL_RAPIDAPI_KEY=

# Tennis — https://livetennisapi.com (palier gratuit, 100 req/jour).
# ATP, WTA, Challenger et ITF. Passe depuis une IP datacenter, lui.
#
# ⚠️ Deux pièges déjà traités dans le code, notés ici pour la trace :
#  - le filtre de date s'appelle `from`/`to` ; `date` est accepté et IGNORÉ en
#    silence (une requête sur le 15/08 rendait des matchs du 24/06 au 17/08) ;
#  - `status` vaut « completed » sur 100 % des lignes, y compris 30 % de
#    relevés partiels ou d'abandons. Le code exige que le vainqueur ait le
#    compte de sets de son format, et écarte les doubles dont les noms
#    arrivent mutilés.
SCORES_TENNIS_KEY=

# Pont navigateur pour les résultats de football.
#
# À 1, `results-update` ne fait AUCUN appel : il lit les fichiers déposés par
# tools/scores-ingest.user.js dans data/scores/soccer/<jour>.json. Le userscript
# appelle l'API depuis l'IP résidentielle du PC, puis repose la réponse BRUTE —
# le parseur est le même que sur la route directe, donc toutes les mesures
# faites sur elle restent valables.
#
# Le choix est explicite, jamais deviné : un repli automatique du direct vers
# le pont masquerait le refus d'IP qu'on veut précisément voir.
SCORES_FOOTBALL_BRIDGE=0
SCORES_INGEST_DIR=data/scores
SCORES_BRIDGE_DAYS=3          # journées ACHEVÉES suivies par le plan
SCORES_FINAL_AFTER_SEC=21600  # au-delà, une journée n'est plus jamais redemandée

# Alerte « softbook muet » sur le canal critique.
#
# Un book qui cesse de produire ne se voyait NULLE PART : le 16/08, Betano est
# resté quatre heures sans une seule cote — onglet fermé — et le seul symptôme
# était une ligne de valuebet.log que personne ne lisait.
#
# Il faut les DEUX seuils. La durée seule se déclencherait sur un cycle
# anormalement long (pendant une purge ils montent à 9-24 min). Le nombre de
# cycles seul ne veut rien dire non plus : cinq cycles valent deux minutes ou
# deux heures selon le moment.
#
# 15 min et non les 20 de Pinnacle : les books les plus rapides corrigent en
# 4 à 6 minutes, donc un quart d'heure d'aveuglement coûte déjà des occasions.
# La liste des books surveillés se construit seule — un book y entre le jour
# où il rend sa première cote, donc un book coupé n'alerte jamais à vide.
BOOK_ALERT_AFTER_MIN=15
BOOK_ALERT_AFTER_CYCLES=5

# Fenêtre morte avant le coup d'envoi — VALUE BETS (principal, premium, critique).
#
# Mesuré le 17/08 sur 6 486 opportunités dédupliquées : la tranche 5-15 min est
# la MEILLEURE du système, pas la pire comme le code le supposait.
#   premium    > 15 min : +9,73 %  (76,9 % pos)   5-15 min : +10,97 % (89,9 %)
#   principal  > 15 min : +3,49 %  (67,7 % pos)   5-15 min :  +5,32 % (93,5 %)
# L'érosion y est aussi la plus faible (-2,4 à -3,3 points contre -4,6 à -6,7
# ailleurs), donc le CLV n'y est pas une simple répétition de l'EV de départ.
#
# ⚠️ 5 est un PLANCHER PHYSIQUE, pas un arbitrage : la tranche 0-5 min est vide
# sur tout l'historique, Pinnacle retirant ses marchés prématch avant le coup
# d'envoi. Descendre plus bas n'apporterait rien.
TELEGRAM_MIN_MINUTES_TO_KICKOFF=5

# ── Surebets : COUPÉS depuis le 21/08 ────────────────────────────────────
#
# SCAN_SUREBETS coupe le CALCUL et la DIFFUSION d'un seul coup : les deux
# canaux Telegram dédiés (prématch et live) et la copie vers le canal critique
# au-delà de TELEGRAM_MIN_CRITICAL_SUREBET. Absent ou à 0 = coupé.
#
# ⚠️ NE PAS vider TELEGRAM_SUREBET_CHAT_ID pour obtenir le même effet :
# l'identifiant vide fait RETOMBER sur le canal PRINCIPAL, donc les surebets
# iraient le polluer au lieu de disparaître. Ces identifiants servent aussi la
# liste blanche du listener : les effacer couperait ces canaux de /scan.
#
# Coût mesuré du calcul (900 événements, 8 books, ~44 000 cotes) : ~1,0 s par
# sport. Les sports tournant en parallèle, le cycle ne raccourcit que d'environ
# 1 s sur ~54 s — les surebets réutilisent des cotes déjà téléchargées, il n'y
# a aucun gain réseau à en attendre.
#
# Réactiver : SCAN_SUREBETS=1 puis sudo systemctl restart valuebet-daemon.
# Rien n'a été supprimé — moteur, table de dédup, réglages ci-dessous et
# commande `scan-surebets` sont intacts.
SCAN_SUREBETS=0

# ── Middles : COUPÉS depuis le 22/08 ─────────────────────────────────────
#
# Ils ne sont plus joués, donc le calcul ne sert plus à rien. Absent ou à 0 =
# coupé. Réglage SÉPARÉ de SCAN_SUREBETS, pour pouvoir rallumer l'un sans
# l'autre.
#
# ⚠️ Le CANAL n'est pas touché, et il ne faut pas le toucher : les middles
# partaient sur le canal CLV, PARTAGÉ avec les alertes de CLV qu'on garde. La
# coupure passe donc par le calcul, jamais par le canal.
#
# Coût mesuré (900 événements, 8 books, ~65 000 cotes de totaux) : 0,24 s par
# sport. Avec les surebets, ~1,24 s au total, soit ~2 % d'un cycle de ~54 s.
#
# Réactiver : SCAN_MIDDLES=1 puis sudo systemctl restart valuebet-daemon.
SCAN_MIDDLES=0

# --- EliteSports : balayage PROFOND (horizon élargi) ------------------------
# La route globale du book pose une fenêtre de ~2 jours : 1 480 événements du
# 22 au 24/08, mesuré. La route PAR LIGUE ne la pose pas — la Coupe
# d'Allemagne y va jusqu'au 2 septembre.
#
# Balayer les 302 ligues coûte 302 appels et 55 s, et rend 255 événements
# exploitables de plus (J+0 à J+8 ; au-delà Pinnacle ne price plus, donc aucune
# ligne juste n'existe). Répartition, à lire avec le §9 :
#   J+1-J+2 :  78 -> le creux, CLV -2,70 % (n=35, non significatif)
#   J+3-J+8 : 166 -> la tranche >48 h, CLV +6,38 %, significative a +3,0 sigma
#
# Les 55 s tournent EN FOND, jamais dans le cycle — motif de BetFirst. Mettre
# ce balayage dans le cycle silencierait le sport entier, ce qui avait fait
# retirer Smarkets en juillet.
ELITESPORTS_DEEP_ENABLED=1
ELITESPORTS_DEEP_REFRESH_SEC=900     # des cotes a J+5 ne bougent pas en 30 s
ELITESPORTS_DEEP_MAX_AGE_SEC=3600    # au-dela, RIEN plutot que des cotes mortes

# Fenêtre morte — SUREBETS et MIDDLES, séparée volontairement.
#
# Le risque n'y est pas le même. Un value bet se mesure contre une référence
# sharp, qui le protège d'une cote périmée. Un surebet est une incohérence
# ENTRE deux books : une seule ligne figée chez l'un suffit à fabriquer un
# arbitrage qui n'existe pas. La mesure ci-dessus ne porte QUE sur les value
# bets — l'étendre aux surebets serait aller au-delà de ce qui la soutient.
TELEGRAM_SUREBET_MIN_MINUTES_TO_KICKOFF=15

# Cadence des appels à Live Tennis. Son palier Basic plafonne à 60 requêtes par
# minute : un rattrapage de soixante jours enchaîne soixante appels et tombe
# exactement sur la limite, échouant en plein milieu et laissant la moitié de
# l'historique sans résultat. 1,1 s rend 54 req/min — marge suffisante, et le
# rattrapage complet ne prend qu'environ 70 secondes.
SCORES_TENNIS_MIN_INTERVAL_SEC=1.1
