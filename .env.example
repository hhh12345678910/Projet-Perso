# Copy to .env and fill in. Never commit .env.
# Betano cookie: capture from your browser (DevTools → Network → any
# /danae-webapi/ request → Copy as cURL → extract the value after `-b '`).
# Expires every few hours (Cloudflare cf_clearance + DataDome tokens).
BETANO_COOKIE=
BETANO_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36
# Optional override (default already targets Betano BE / French)
BETANO_X_LANGUAGE=9
BETANO_X_OPERATOR=22

# ---------------------------------------------------------------------------
# Import d'historique des paris (suivi P&L réel — commande `import-history`).
# Chaque book Kambi expose l'historique du compte connecté à une URL du type
# .../player/api/v2019/<offering>/coupon/history.json. Récupère depuis ton
# navigateur (connecté) : DevTools → Network → la requête coupon/history.json
#   • Copier l'URL complète        → <PREFIX>_HISTORY_URL
#   • Copier le header Cookie       → <PREFIX>_COOKIE
# Entoure chaque valeur de guillemets SIMPLES (cookie/URL contiennent des
# caractères spéciaux) car .env est sourcé par bash. La session expire : à
# recapturer quand `import-history` renvoie une erreur d'authentification.
UNIBET_HISTORY_URL=
UNIBET_COOKIE=
SEVEN_ELEVEN_HISTORY_URL=
SEVEN_ELEVEN_COOKIE=
BINGOAL_HISTORY_URL=
BINGOAL_COOKIE=
SCOOORE_HISTORY_URL=
SCOOORE_COOKIE=
# À n'ajuster QUE si les montants/cotes sortent faux face à une vraie capture
# (défauts : entiers ×1000). Vérifie avec `import-history --dump-raw` puis
# `inspect-kambi-history`.
# KAMBI_MONEY_SCALE=1000
# KAMBI_ODDS_SCALE=1000
